{
  // Workers Builds deploys whatever `assets.directory` points at. The site has no build step and
  // no dependencies, so the asset directory is the repository root.
  // The name must match the Worker that already exists. The first build ran before this config
  // was here, so Wrangler auto-generated one and named the Worker 'site'. A different name
  // deploys a second, separate Worker and leaves the live one serving stale assets.
  "name": "site",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "."
  },
  // Required for `wrangler preview`, which is what Workers Builds runs on a pull request branch.
  // It can be empty: assets, compatibility settings and placement stay at the top level. Without
  // it the preview build fails outright and no Preview URL is ever posted to the pull request.
  "previews": {}
}
